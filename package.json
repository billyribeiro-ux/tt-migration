{
	"name": "trick-trades-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"catalog:sync": "node scripts/sync-migration-catalog.mjs",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:seed": "node --env-file-if-exists=.env scripts/seed-admin.mjs",
		"db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"drizzle-kit": "0.31.10",
		"svelte": "^5.56.9",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.1.0",
		"drizzle-orm": "0.45.2",
		"postgres": "^3.4.9"
	}
}
