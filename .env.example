# Neon Postgres connection string used by Drizzle in edge and Node runtimes.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/trick_trades?sslmode=require
DATABASE_RUNTIME_ENABLED=true

# Local client-demo identity. Keep the real username in .env, which is ignored.
SHOWCASE_ADMIN_USERNAME=client-admin
SHOWCASE_ADMIN_PASSWORD=
SHOWCASE_ADMIN_PASSWORD_HASH=
SHOWCASE_SESSION_SECRET=
SHOWCASE_ADMIN_ENABLED=false
